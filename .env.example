SENTINEL_APP_NAME=智卫 Sentinel
SENTINEL_ENV=development
SIMULATION_MODE=true
SENTINEL_SITE_ID=demo-site
SENTINEL_DATABASE=./data/sentinel.sqlite3
SENTINEL_STALE_AFTER_SECONDS=5
SENTINEL_HEARTBEAT_TIMEOUT_SECONDS=8
SENTINEL_CLOCK_TOLERANCE_SECONDS=5
SENTINEL_SIMULATION_INTERVAL=1

# Live mode requires both tokens. Use independent, unpredictable values.
SENTINEL_CONTROL_TOKEN=
SENTINEL_DEVICE_TOKEN=

# Optional existing LAN MQTT broker; disabled in simulation mode.
SENTINEL_MQTT_HOST=
SENTINEL_MQTT_PORT=1883
SENTINEL_MQTT_USERNAME=
SENTINEL_MQTT_PASSWORD=
SENTINEL_MQTT_TLS=false

# Physical actuation is locked by default. Do not enable before board acceptance.
SENTINEL_COMMAND_TIMEOUT_SECONDS=10
SENTINEL_ALLOW_ACTUATION=false
SENTINEL_AUTO_ACTUATION=false
